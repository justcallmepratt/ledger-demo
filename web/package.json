{
  "name": "ledger-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,scss,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss,html}\""
  },
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.8.0",
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.7",
    "angular-eslint": "22.8.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.22.3"
  }
