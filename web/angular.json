{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/rajdhani/latin-400.css",
              "node_modules/@fontsource/rajdhani/latin-500.css",
              "node_modules/@fontsource/rajdhani/latin-600.css",
              "node_modules/@fontsource/rajdhani/latin-700.css",
              "node_modules/@fontsource/orbitron/latin-400.css",
              "node_modules/@fontsource/orbitron/latin-700.css",
              "node_modules/@fontsource/share-tech-mono/latin-400.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "320kB",
                  "maximumError": "360kB"
                },
                {
                  "type": "allScript",
                  "maximumWarning": "440kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "bundle",
                  "name": "dashboard",
                  "maximumWarning": "21kB",
                  "maximumError": "25kB"
                },
                {
                  "type": "bundle",
                  "name": "transfer-form",
                  "maximumWarning": "15kB",
                  "maximumError": "18kB"
                },
                {
                  "type": "bundle",
                  "name": "pending-transfers",
                  "maximumWarning": "12kB",
                  "maximumError": "15kB"
                },
                {
                  "type": "bundle",
                  "name": "account-detail",
                  "maximumWarning": "12kB",
                  "maximumError": "15kB"
                },
                {
                  "type": "bundle",
                  "name": "activity-page",
                  "maximumWarning": "4kB",
                  "maximumError": "6kB"
                },
                {
                  "type": "bundle",
                  "name": "not-found",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "web:build:production"
            },
            "development": {
              "buildTarget": "web:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
